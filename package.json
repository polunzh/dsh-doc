{
  "name": "@polunzh/dsh-doc",
  "version": "0.2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "打印工坊：把文本/Markdown 排成 A4 讲义 PDF，探测局域网打印机能力后直接双面打印，并回报出纸回执。Print Studio: typeset text into a print-ready A4 PDF and print it duplex on a LAN printer with capability-aware options.",
  "main": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polunzh/dsh-doc.git"
  },
  "homepage": "https://github.com/polunzh/dsh-doc#readme",
  "bugs": {
    "url": "https://github.com/polunzh/dsh-doc/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "screenshot": "node scripts/capture-preview.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "printing",
    "handout",
    "pdf",
    "cups"
  ],
  "license": "MIT"
}
